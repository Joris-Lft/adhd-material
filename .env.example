# Projet Supabase (Settings > API). Seule la clé publishable (publique) va ici,
# jamais la clé secret / service_role.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Connexion par email (code à 8 chiffres) : désactivée par défaut, connexion Google uniquement.
# À activer ("true" exactement) seulement quand un SMTP perso et les modèles d'email sont branchés
# côté Supabase (l'offre gratuite refuse les modèles personnalisés sans SMTP perso).
# VITE_AUTH_EMAIL_ENABLED=true
